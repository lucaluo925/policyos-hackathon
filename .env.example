# Copy to .env.local and fill in. Nothing here is a real credential.
#
# No variables are required for the country directory, public announcement
# reader and claim-only verification starters. Database-backed collection and live verification are
# optional features described below.

# --- optional database --------------------------------------------------
# PostgreSQL. Any Postgres works; the deployed instance uses Neon.
# Without it the app still renders, but every counter reads "—" rather than
# inventing a number.
DATABASE_URL="postgresql://user:password@localhost:5432/policyos"

# --- claim verification (/verify) ---------------------------------------
# Nebius Token Factory, OpenAI-compatible. Serves the NVIDIA Nemotron 3
# models the verification pipeline runs on. https://tokenfactory.nebius.com
# Without it /verify loads and claim starters still fill the form; starting a
# live run returns 503 with the missing variable named.
NEBIUS_API_KEY=""

# Tavily Search and optional Extract, used for live retrieval and source reading. https://tavily.com
# Same degradation as above: claim starters work, live runs do not.
TAVILY_API_KEY=""
# Optional read-only contest build: clearly pauses and blocks metered search
# and verification. Remove and rebuild when funded live access is ready.
NEXT_PUBLIC_STATIC_DEMO_MODE=""
# Set to 1 on multi-instance public hosts unless VERCEL=1 is exposed.
# Country research then requires DATABASE_URL and fails closed if unavailable.
COUNTRY_RESEARCH_REQUIRE_SHARED_QUOTA=""
# Verification also reserves one run before any paid call on public hosts.
# Vercel deployment config sets this to 1; local development can omit it.
VERIFY_REQUIRE_SHARED_QUOTA=""
VERIFY_DAILY_RUN_CAP="12"
# Public live verification also needs a persistent cumulative model budget.
# Set after reviewing provider prices. Reuse the same ID across deployments;
# never change the ID to reset spend. Expiry requires a fresh operator review.
VERIFY_MODEL_BUDGET_ID=""
VERIFY_MODEL_BUDGET_USD=""
VERIFY_MODEL_BUDGET_EXPIRES_AT=""

# Rolling-24h admission check based on assertions in completed audit rows.
# Defaults to 12. This secondary check is non-atomic; the separate shared
# run reservation counts failed/unfinished attempts and fails closed on
# public hosts. Neither is a provider billing ceiling or a guarantee that
# judging-period credits will last.
VERIFY_DAILY_ASSERTION_CAP="12"

# --- optional -----------------------------------------------------------
# Set only after a public source repository actually exists. Until then the
# footer omits the repository link rather than pointing to a missing page.
SOURCE_REPO_URL=""

# Admin console at /admin. Without it the console cannot be signed into.
ADMIN_PASSWORD=""

# Shared secret for scheduled ingestion routes. Production refuses to run
# without it; local development retains its existing fallback.
CRON_SECRET=""

# Vercel Blob, used for snapshot storage. Without it snapshots are skipped.
BLOB_READ_WRITE_TOKEN=""

# Judge isolation: OFF by default. Prepare/test only until organizer confirmation.
# When activated, both /api/verify and /api/explore/research require a judge session.
# Use a separate randomly generated secret (at least 32 characters), server-only,
# never ADMIN_PASSWORD or a provider key. Rotation invalidates all sessions.
# Sessions end at the earlier of the existing model budget expiry and judging end.
VERIFY_JUDGE_ACCESS_ENABLED="0"
VERIFY_JUDGE_ACCESS_SECRET=""

# Historical cost checkpoint: leave off until the reviewed checkpoint is applied.
# After approval/application set to 1 so a missing checkpoint/old DB restore
# cannot silently restore funds. A stored checkpoint is always counted, even
# if this flag is later unset. No new budget/campaign is created.
VERIFY_MODEL_COST_CHECKPOINT_REQUIRED="0"
