# Copy to .env.local and fill in. Nothing here is a real credential.
#
# No variables are required for the country directory, public announcement
# reader and claim-only verification starters. Database-backed collection and live verification are
# optional features described below.

# --- optional database --------------------------------------------------
# PostgreSQL. Any Postgres works; the deployed instance uses Neon.
# Without it the app still renders, but every counter reads "—" rather than
# inventing a number.
DATABASE_URL="postgresql://user:password@localhost:5432/policyos"

# --- claim verification (/verify) ---------------------------------------
# Nebius Token Factory, OpenAI-compatible. Serves the NVIDIA Nemotron 3
# models the verification pipeline runs on. https://tokenfactory.nebius.com
# Without it /verify loads and claim starters still fill the form; starting a
# live run returns 503 with the missing variable named.
NEBIUS_API_KEY=""

# Tavily Search and optional Extract, used for live retrieval and source reading. https://tavily.com
# Same degradation as above: claim starters work, live runs do not.
TAVILY_API_KEY=""
# Optional read-only contest build: clearly pauses and blocks metered search
# and verification. Remove and rebuild when funded live access is ready.
NEXT_PUBLIC_STATIC_DEMO_MODE=""
# Set to 1 on multi-instance public hosts unless VERCEL=1 is exposed.
# Country research then requires DATABASE_URL and fails closed if unavailable.
COUNTRY_RESEARCH_REQUIRE_SHARED_QUOTA=""
# Verification also reserves one run before any paid call on public hosts.
# Vercel deployment config sets this to 1; local development can omit it.
VERIFY_REQUIRE_SHARED_QUOTA=""
VERIFY_DAILY_RUN_CAP="12"
# Public live verification also needs a persistent cumulative model budget.
# Set after reviewing provider prices. Reuse the same ID across deployments;
# never change the ID to reset spend. Expiry requires a fresh operator review.
VERIFY_MODEL_BUDGET_ID=""
VERIFY_MODEL_BUDGET_USD=""
VERIFY_MODEL_BUDGET_EXPIRES_AT=""

# Rolling-24h admission check based on assertions in completed audit rows.
# Defaults to 12. This secondary check is non-atomic; the separate shared
# run reservation counts failed/unfinished attempts and fails closed on
# public hosts. Neither is a provider billing ceiling or a guarantee that
# judging-period credits will last.
VERIFY_DAILY_ASSERTION_CAP="12"

# --- optional -----------------------------------------------------------
# Set only after a public source repository actually exists. Until then the
# footer omits the repository link rather than pointing to a missing page.
SOURCE_REPO_URL=""

# Admin console at /admin. Without it the console cannot be signed into.
ADMIN_PASSWORD=""

# Shared secret for scheduled ingestion routes. Production refuses to run
# without it; local development retains its existing fallback.
CRON_SECRET=""

# Vercel Blob, used for snapshot storage. Without it snapshots are skipped.
BLOB_READ_WRITE_TOKEN=""

# Judge isolation: OFF by default. Prepare/test only until organizer confirmation.
# When activated, both /api/verify and /api/explore/research require a judge session.
# Use a separate randomly generated secret (at least 32 characters), server-only,
# never ADMIN_PASSWORD or a provider key. Rotation invalidates all sessions.
# Sessions end at the earlier of the existing model budget expiry and judging end.
VERIFY_JUDGE_ACCESS_ENABLED="0"
VERIFY_JUDGE_ACCESS_SECRET=""

# Historical cost checkpoint: leave off until the reviewed checkpoint is applied.
# After approval/application set to 1 so a missing checkpoint/old DB restore
# cannot silently restore funds. A stored checkpoint is always counted, even
# if this flag is later unset. No new budget/campaign is created.
VERIFY_MODEL_COST_CHECKPOINT_REQUIRED="0"

# ========================================================================
# OSIRIS intelligence module (/osiris)
# ========================================================================
# Upstream: carbon-evolution/osiris (MIT). The module works with NO keys at
# all: aviation, satellites, fires, earthquakes, weather, news and CVE layers
# all run on public keyless feeds, and every route below fails soft when its
# variable is absent. None of these names collide with the PolicyOS variables
# above, and the OSIRIS Postgres layer uses its own PG_* connection rather
# than DATABASE_URL, so it never touches the Prisma schema.

# --- recon scanner backend ----------------------------------------------
# Powers the RECON toolkit. Needs the separate OSIRIS scanner backend running;
# SCANNER_KEY must equal that backend's OSIRIS_KEY (openssl rand -hex 32).
# Leave empty to disable RECON (the UI returns 503).
SCANNER_URL=""
SCANNER_KEY=""
# /api/scanner makes this server probe arbitrary public hosts, so production
# refuses remote callers with 403 unless one of these is set. Do not enable
# SCANNER_ALLOW_ANONYMOUS on a public deployment: it turns the server into an
# open scan relay that targets see as originating from your IP.
SCANNER_ACCESS_TOKEN=""
SCANNER_ALLOW_ANONYMOUS="false"

# --- AI analyst (/osiris natural-language queries and briefings) --------
# Gemini keys for /api/ai/analyze and /api/ai/briefing, read as a numbered
# series (1 through 8) and rotated across calls. A key sent by the visitor in
# the X-Gemini-Key header always takes priority over these.
#
# WARNING before setting any of these on a public deployment: these two routes
# are the only ones behind the OSIRIS rate limiter, and that limiter FAILS OPEN
# when Redis is unreachable (src/lib/osiris/rateLimit.ts). With no REDIS_URL
# configured there is no throttle, so a server-side key here means uncapped
# model spend from a public URL. Prefer leaving these empty and letting the
# analyst run on each visitor's own key. See CODE_REVIEW.md, 2026-11-08.
GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2= … GEMINI_API_KEY_8=  (same meaning, used for rotation)

# --- optional data-source keys (higher limits / extra layers) -----------
# ACLED geocoded conflict events; without it the incidents layer falls back
# to keyless GDELT. https://acleddata.com/register/
ACLED_EMAIL=""
ACLED_PASSWORD=""
ACLED_ACCESS_TOKEN=""
ACLED_CLIENT_ID=""
# Live maritime AIS over WebSocket. https://aisstream.io
AIS_API_KEY=""
AIS_RETENTION_MS=""
AIS_MAX_SHIPS=""
# Kpler vessel enrichment on top of the AIS feed; fail-soft when absent.
KPLER_BASIC=""
KPLER_CLIENT_ID=""
KPLER_CLIENT_SECRET=""
KPLER_AUDIENCE=""
KPLER_AUTH_URL=""
KPLER_GRAPHQL_URL=""
# National CCTV networks.
ITS_KR_KEY=""
TRAFIKVERKET_KEY=""
# Threat-intel lookups. Each one only disables its own OSINT tool.
ABUSEIPDB_KEY=""
ISMALICIOUS_KEY=""
ISMALICIOUS_SECRET=""
OTX_API_KEY=""
URLHAUS_AUTH_KEY=""
URLHAUS_KEY=""
THREATFOX_AUTH_KEY=""
MALWAREBAZAAR_AUTH_KEY=""
# Self-hosted vulnerability tooling, read by the local-intel panel.
DEFECTDOJO_URL=""
DEFECTDOJO_TOKEN=""
DTRACK_URL=""
INTEL_URL=""

# --- optional local-first datastores ------------------------------------
# Only the worker pipeline, the IOC index and /api/health/local use these.
# Without them those features report unavailable; the map itself is unaffected.
# Bring the stack up with: npm run osiris:data:up
LOCAL_FIRST=""
PG_HOST=""
PG_PORT=""
PG_USER=""
PG_PASSWORD=""
PG_DB=""
REDIS_URL=""
OPENSEARCH_URL=""
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""

# --- misc ---------------------------------------------------------------
# Ingest key for the OSIRIS SDK routes.
SDK_INGEST_KEY=""
# GitHub webhook relay (/api/github-webhook): 503 unless BOTH are set.
GITHUB_WEBHOOK_SECRET=""
GITHUB_WEBHOOK_FORWARD_URL=""
# Absolute origin used for server-side calls back into this app.
INTERNAL_ORIGIN=""
# Client-IP trust for rate limits and the audit log. Forwarding headers are
# ignored unless set, because Next passes a client-sent X-Forwarded-For
# through unchanged. "true" = one proxy, "<N>" = N proxies, "cloudflare" =
# CF-Connecting-IP.
TRUST_PROXY_HEADERS=""
# Self-hosted Umami page-view analytics. OFF unless BOTH are set.
UMAMI_URL=""
UMAMI_WEBSITE_ID=""
