{
  "name": "policyos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test src/lib/*/__tests__/*.test.ts",
    "events:backfill": "tsx scripts/events-backfill.ts",
    "pipeline:dry-run": "tsx scripts/pipeline-dry-run.ts",
    "events:sync-review": "tsx scripts/events-sync-review.ts",
    "verify:smoke": "tsx --env-file=.env.local scripts/verify-smoke.ts",
    "verify:budget-audit": "node --import tsx scripts/verify-budget-audit.ts",
    "verify:seed": "tsx --env-file=.env.local scripts/seed-verify-examples.ts",
    "verify:probe-faithfulness": "tsx --env-file=.env.local scripts/probe-decompose-faithfulness.ts",
    "verify:cost-checkpoint:preview": "node --import tsx scripts/verify-cost-checkpoint-preview.ts",
    "osiris:workers": "tsx src/workers/scheduler.ts",
    "osiris:test": "vitest run",
    "osiris:data:up": "docker compose -f backend/docker-compose.data.yml --profile standard up -d",
    "osiris:data:down": "docker compose -f backend/docker-compose.data.yml down"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.4",
    "@deck.gl/layers": "^9.3.4",
    "@deck.gl/mapbox": "^9.3.4",
    "@google/generative-ai": "^0.24.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "@prisma/client": "^6.19.3",
    "@turf/turf": "^7.3.5",
    "@types/geojson": "^7946.0.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "framer-motion": "^12.40.0",
    "google-libphonenumber": "^3.2.44",
    "h3-js": "^4.4.0",
    "hls.js": "^1.6.16",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "6.14.0",
    "neo4j-driver": "^6.1.0",
    "next": "16.4.0",
    "node-cron": "^4.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "proj4": "^2.20.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "satellite.js": "^7.0.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.4"
  },
  "license": "MIT"
}
